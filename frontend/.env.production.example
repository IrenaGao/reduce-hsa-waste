# Production Environment Variables for Netlify
# Add these in Netlify Dashboard > Site Settings > Environment Variables

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_production_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_production_secret_key_here

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_REGION=us-east-2
AWS_S3_BUCKET_NAME=your-production-bucket-name

# Application URL
NEXT_PUBLIC_BASE_URL=https://your-app-name.netlify.app
