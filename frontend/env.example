# Stripe Configuration
# Get these from your Stripe Dashboard (https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Application URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# AWS S3 Configuration for LMN Document Storage
# Get these from your AWS Console (https://console.aws.amazon.com/iam/)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-lmn-documents-bucket-name

# Note: 
# - Use test keys (pk_test_ and sk_test_) for development
# - Use live keys (pk_live_ and sk_live_) for production
# - Never commit your secret keys to version control
# - Copy this file to .env.local and fill in your actual keys
# - Create an S3 bucket for LMN document storage
# - Ensure your AWS user has S3 read/write permissions
