// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  dateOfBirth String?
  sex       String?
  stateOfResidence String?
  hsaProvider String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings Booking[]
  lmnDocuments LMNDocument[]
  receipts Receipt[]
  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Booking {
  id              String   @id @default(cuid())
  userId          String
  serviceName     String
  serviceCategory String
  servicePrice    Float
  appointmentDate String
  appointmentTime String
  paymentMethod   String
  status          String   @default("confirmed") // confirmed, completed, cancelled
  confirmationNumber String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt Receipt?
  lmnDocument LMNDocument?

  @@map("bookings")
}

model Receipt {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  userId          String
  paymentIntentId String?
  stripePaymentId String?
  amount          Float
  currency        String   @default("usd")
  status          String   // paid, pending, failed, refunded
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model LMNDocument {
  id                String   @id @default(cuid())
  bookingId         String?  @unique
  userId            String
  patientName       String
  providerName      String
  serviceName       String
  generatedDate     String
  status            String   // ready, submitted, approved, denied
  content           String
  digitalId         String?
  s3Key             String?
  s3Url             String?
  storageLocation   String   @default("database") // database, s3
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lmn_documents")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
